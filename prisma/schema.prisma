generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String   @default("123456")
  role        String   @default("TECNICO") // ADMIN, GERENTE, TECNICO, ATENDENTE
  permissions String    @default("[]")      // JSON array of specific permissions
  active      Boolean   @default(true)
  failedAttempts Int    @default(0)
  lockedUntil    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt

  assignedOrders   WorkOrder[]        @relation("TechnicianOrders")
  technicianCourses TechnicianCourse[]
  auditLogs        AuditLog[]
}

model Situation {
  id         String   @id @default(uuid())
  name       String   @unique
  color      String   @default("#e2e8f0")
  isCanceled Boolean  @default(false) // If true, excluded from SLA metrics (ex: "Anulada")
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  workOrders WorkOrder[]
}

model Location {
  id          String   @id @default(uuid())
  code        String   @unique // ex: "1A", "16H"
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  workOrders WorkOrder[]
}

model EquipmentType {
  id        String   @id @default(uuid())
  name      String   @unique // ex: "EcoTank", "Projetor", "Térmica", "Comercial"
  createdAt DateTime @default(now())

  models EquipmentModel[]
}

model EquipmentModel {
  id        String        @id @default(uuid())
  name      String        @unique // ex: "L3250", "CO-W01"
  typeId    String
  type      EquipmentType @relation(fields: [typeId], references: [id])
  createdAt DateTime      @default(now())

  workOrders WorkOrder[]
}

model Course {
  id          String   @id @default(uuid())
  title       String   @unique
  description String?
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())

  technicianCourses TechnicianCourse[]
}

model TechnicianCourse {
  id           String    @id @default(uuid())
  technicianId String
  technician   User      @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completed    Boolean   @default(false)
  completedAt  DateTime?

  @@unique([technicianId, courseId])
}

model AnnualAudit {
  id         String   @id @default(uuid())
  fiscalYear Int      @unique // ex: 2026
  score      Float    @default(80.0) // 0 to 100
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WorkOrder {
  id           String          @id @default(uuid())
  osNumber     String          @unique
  modelId      String
  model        EquipmentModel  @relation(fields: [modelId], references: [id])
  serialNumber String
  situationId  String
  situation    Situation       @relation(fields: [situationId], references: [id])
  locationId   String?
  location     Location?       @relation(fields: [locationId], references: [id])

  // Dates and milestones
  entryDate         DateTime
  diagnosisDate     DateTime?
  emailSentDate     DateTime?
  emailReceivedDate DateTime?

  // Parts
  partsOrderDate    DateTime?
  partsInvoiceDate  DateTime? // Faturamento
  partsHeadQty      Int       @default(0) // 0 to 10
  partsTotalQty     Int       @default(0) // 0 to 30
  partsArrivalDate  DateTime?
  partsChangeInk    Boolean   @default(false) // Trocar Tinta (Sim/Não)

  // Repair
  repairDate        DateTime?
  isRecurrent       Boolean   @default(false)
  tmfDays           Int?

  // Notices
  notice1Date       DateTime?
  notice2Date       DateTime?
  notice3Date       DateTime?

  // System and Physical Exit
  systemExitDate    DateTime?
  exitDate          DateTime?

  // Assignment & Notes
  technicianId      String?
  technician        User?     @relation("TechnicianOrders", fields: [technicianId], references: [id])
  notes             String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  userName    String
  userEmail   String?
  action      String   // CREATE, UPDATE, DELETE
  entity      String   // WorkOrder, Course, Situation, etc.
  entityId    String
  details     String
  oldValues   String?  // JSON
  newValues   String?  // JSON
  createdAt   DateTime @default(now())
}

model RecordLock {
  id         String   @id @default(uuid())
  entityType String   // e.g. "WorkOrder"
  entityId   String   // ID do registro bloqueado
  userId     String   // ID do usuário que iniciou a edição
  userName   String   // Nome do usuário para exibição
  userEmail  String?
  lockedAt   DateTime @default(now())
  expiresAt  DateTime // Data/hora de expiração automática (TTL)

  @@unique([entityType, entityId])
}

// ==============================================================
// MÓDULO: VIPZ INFOGED (CLUBE DE BENEFÍCIOS & FIDELIDADE)
// ==============================================================

model VipzCustomer {
  id                     String            @id @default(uuid())
  erpCustomerId          String?           // ID de referência no Gestão Click
  name                   String
  cpfCnpj                String            @unique
  email                  String?
  phone                  String?
  cep                    String?
  address                String?
  number                 String?
  complement             String?
  neighborhood           String?
  city                   String?
  state                  String?
  birthDate              DateTime?
  pointsBalance          Int               @default(0)
  totalPointsAccumulated Int               @default(0)
  totalPointsRedeemed    Int               @default(0)
  totalSpent             Float             @default(0.0)
  tier                   String            @default("BRONZE") // BRONZE, PRATA, OURO, VIPZ_BLACK
  active                 Boolean           @default(true)
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  transactions           VipzTransaction[]
  redemptions            VipzRedemption[]
}

model VipzTransaction {
  id          String       @id @default(uuid())
  customerId  String
  customer    VipzCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String       // "PURCHASE" (Venda confirmada), "REDEMPTION" (Resgate), "BONUS", "ADJUSTMENT", "EXPIRATION"
  points      Int          // Positivo para crédito, negativo para débito
  saleValue   Float?       // Valor financeiro correspondente em R$
  erpSaleId   String?      // ID da venda/recebimento no Gestão Click
  description String
  expiresAt   DateTime?    // Expira em 1 ano (365 dias)
  isExpired   Boolean      @default(false)
  createdAt   DateTime     @default(now())
}

model VipzTier {
  id            String   @id @default(uuid())
  name          String   @unique // ex: "Bronze", "Prata", "Ouro", "VIPZ Black"
  code          String   @unique // "BRONZE", "PRATA", "OURO", "VIPZ_BLACK"
  minPoints     Int      @default(0) // Pontos acumulados necessários para atingir
  multiplier    Float    @default(1.0) // Multiplicador de pontos (ex: 1.2 = +20%)
  benefits      String?  // Descrição geral dos benefícios
  color         String   @default("#d97706") // Cor do selo/badge
  bonusServices String?  // JSON com serviços bônus e data de vencimento: [{"serviceName": "Limpeza", "validUntil": "2026-12-31"}]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VipzReward {
  id           String           @id @default(uuid())
  erpProductId String?          // ID do produto no Gestão Click
  erpItemId    String?          // ID do item (produto ou serviço) no Gestão Click
  erpItemType  String?          @default("PRODUTO") // "PRODUTO" ou "SERVICO"
  erpItemCode  String?          // Código/SKU no Gestão Click
  originalPrice Float?          // Preço de venda original no ERP
  rewardType   String           @default("PRODUTO") // "PRODUTO", "CUPOM_VALOR", "CUPOM_PERCENTUAL", "SERVICO"
  discountValue Float?          // Valor monetário de desconto (R$) ou percentual (%)
  validityDays Int              @default(30) // Dias de validade do cupom emitido
  termsOfUse   String?          // Regras e condições de uso
  title        String
  description  String?
  category     String           @default("PRODUTO") // "PRODUTO", "DESCONTO", "BRINDE", "SERVICO"
  pointsCost   Int              // Custo em pontos
  stock        Int              @default(10) // Saldo em estoque
  active       Boolean          @default(true)
  imageUrl     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  redemptions  VipzRedemption[]
}

model VipzRule {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique // ex: "BASICA", "CONTADORES", "CAMPANHA_1"
  type          String   @default("BASICA") // "BASICA", "CONTADORES", "CUSTOM"
  description   String?
  pointsPerReal Float    @default(1.0) // ex: R$ 1,00 = 1 ponto (ou 0.5, 2, etc.)
  fixedPoints   Int      @default(0)   // Pontos fixos bônus
  minSaleValue  Float    @default(0.0) // Valor mínimo de venda para ativar
  targetTier    String   @default("TODOS") // TODOS, BRONZE, PRATA, OURO, VIPZ_BLACK
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VipzRedemption {
  id          String       @id @default(uuid())
  customerId  String
  customer    VipzCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      VipzReward   @relation(fields: [rewardId], references: [id])
  pointsSpent Int
  voucherCode String       @unique // ex: VIPZ-8924A
  status      String       @default("EMITIDO") // "EMITIDO", "RESGATADO", "CANCELADO"
  redeemedAt  DateTime?
  createdAt   DateTime     @default(now())
}

model VipzSettings {
  id                 String   @id @default("default")
  pointsPerReal      Float    @default(1.0) // R$ 1,00 = 1 ponto
  pointsValidityDays Int      @default(365) // Validade em dias
  silverThreshold    Int      @default(1000)
  goldThreshold      Int      @default(3000)
  blackThreshold     Int      @default(7000)
  silverMultiplier   Float    @default(1.2) // +20%
  goldMultiplier     Float    @default(1.5) // +50%
  blackMultiplier    Float    @default(2.0) // 2x
  isErpSyncActive    Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

// ==========================================
// MÓDULO: PEDIDO DE PRODUTOS & COTAÇÕES
// ==========================================

model ProductStockLimit {
  id            String   @id @default(uuid())
  produtoId     String   @unique
  codigoInterno String?
  nome          String?
  estoqueMinimo Float    @default(0)
  estoqueMaximo Float    @default(0)
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductQuotation {
  id              String   @id @default(uuid())
  numero          String   @unique // ex: "0001", "0002"
  sequencial      Int      @unique @default(autoincrement())
  nomeFornecedor  String?
  fornecedorId    String?
  valorTotal      Float    @default(0)
  quantidadeItens Int      @default(0)
  observacoes     String?
  itens           String   // JSON com lista de itens cotados
  status          String   @default("FINALIZADA") // FINALIZADA, CANCELADA
  criadoPor       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProductCatalogCache {
  produtoId     String   @id
  codigoInterno String?
  nome          String?
  grupoId       String?
  nomeGrupo     String?
  fornecedores  String   @default("[]") // JSON com array de nomes dos fornecedores vinculados no produto
  estoque       Float    @default(0)
  valorCusto    Float    @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([codigoInterno])
  @@index([nomeGrupo])
}

model OutsourcingLocacao {
  id                 String   @id @default(uuid())
  contratoGestaoId   String   @unique
  codigoContrato     String
  clienteId          String?
  nomeCliente        String
  modeloEquipamento  String   @default("")
  numeroSerie        String?
  franquia           Float    @default(0)
  valorPorPagina     Float    @default(0)
  valorTotalContrato Float    @default(0)
  situacao           String   @default("Ativo")
  dataInicio         DateTime?
  proximoVencimento  String?
  diaVencimento      String?
  periodicidade      String?
  observacoes        String?
  servicoIdGestao    String?
  servicoCatalogoId  String?
  
  contadorAtual      Int?
  dataUltimaLeitura  DateTime?

  leituras           OutsourcingLeitura[]
  substituicoes      OutsourcingSubstituicao[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([situacao])
  @@index([nomeCliente])
}

model OutsourcingLeitura {
  id              String   @id @default(uuid())
  locacaoId       String
  locacao         OutsourcingLocacao @relation(fields: [locacaoId], references: [id], onDelete: Cascade)
  dataLeitura     DateTime
  contadorInicial Int      @default(0)
  contadorAtual   Int      @default(0)
  consumo         Int      @default(0)
  franquia        Float    @default(0)
  valorPorPagina  Float    @default(0)
  valorTotal      Float    @default(0)
  observacoes     String?
  equipamentoInfo String?
  criadoPor       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([locacaoId])
  @@index([dataLeitura])
}

model OutsourcingSubstituicao {
  id                    String   @id @default(uuid())
  locacaoId             String
  locacao               OutsourcingLocacao @relation(fields: [locacaoId], references: [id], onDelete: Cascade)
  dataSubstituicao      DateTime @default(now())
  modeloAnterior        String
  numeroSerieAnterior   String?
  contadorFinalAnterior Int      @default(0)
  modeloNovo            String
  numeroSerieNovo       String?
  contadorInicialNovo   Int      @default(0)
  motivo                String?
  criadoPor             String?
  createdAt             DateTime @default(now())

  @@index([locacaoId])
}



